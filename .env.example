# Copy this to .env on each GCP VM and set values for that machine.
# .env is gitignored — never commit it.

# ADB device for local Waydroid (find with: adb devices after boot)
# Common values:
#   127.0.0.1:5555   — Waydroid ADB via socat on the VM itself
ADB_DEVICE=127.0.0.1:5556

# Human-readable name for this VM — shown in ntfy notifications
VM_NAME=GCP2

# ntfy.sh topic for push notifications (scraper stop/failure/heartbeat)
NTFY_TOPIC=retardedjames-tiktok

# Per-term notifications: set to 1 to get a ping after every scraped term.
# Shows: term name, videos saved, VM name. Set to 0 (or omit) to disable.
NTFY_PER_TERM=0

# Optional: override the PostgreSQL connection string
# TIKTOKS_DATABASE_URL=postgresql://app1_user:app1dev@150.136.40.239:5432/tiktoks
