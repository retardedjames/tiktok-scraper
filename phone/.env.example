# Copy to .env (gitignored) and edit for your setup.

# Optional: target a specific ADB device when multiple are attached.
# Run `adb devices` to find your phone's serial.
# ADB_DEVICE=ZN32228T7B

# Human-readable name for this machine/phone (shown in ntfy notifications).
VM_NAME=phone

# ntfy.sh topic for push notifications (scraper stop / failure / heartbeat).
NTFY_TOPIC=retardedjames-tiktok

# Per-term notifications: set to 1 to get a ping after every scraped term.
# Shows: term name, videos saved. Set to 0 (or omit) to disable.
NTFY_PER_TERM=0

# Optional: override the PostgreSQL connection string.
# TIKTOKS_DATABASE_URL=postgresql://app1_user:app1dev@150.136.40.239:5432/tiktoks
