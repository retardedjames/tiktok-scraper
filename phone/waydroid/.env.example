# Copy to .env (gitignored) and edit per VPS.

# Waydroid socat proxy on the host (default — only change if you know why).
ADB_DEVICE=127.0.0.1:5556

# Human-readable name for this VPS (shown in ntfy notifications).
# Make it unique per VM — e.g. VPS1, VPS2, ...
VM_NAME=VPS1

# ntfy.sh topic for push notifications (scraper stop / failure / heartbeat).
NTFY_TOPIC=retardedjames-tiktok

# Per-term notifications: 1 = ping after every scraped term, 0 = only on failure.
NTFY_PER_TERM=0

# Optional: override the PostgreSQL connection string.
# TIKTOKS_DATABASE_URL=postgresql://app1_user:app1dev@150.136.40.239:5432/tiktoks
